{
  "name": "bigfive-web-next",
  "version": "0.0.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore .",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && pnpm run db:migrate:local && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && pnpm run db:migrate:remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "export:results": "node scripts/export-csv.mjs results",
    "export:riasec": "node scripts/export-csv.mjs riasec",
    "export:leads": "node scripts/export-csv.mjs leads",
    "export:feedback": "node scripts/export-csv.mjs feedback",
    "export:enquiries": "node scripts/export-csv.mjs enquiries"
  },
  "dependencies": {
    "@bigfive-org/questions": "1.3.3",
    "@bigfive-org/results": "1.2.9",
    "@bigfive-org/score": "1.2.2",
    "@emotion/is-prop-valid": "1.2.2",
    "@next/third-parties": "15.5.27",
    "@nextui-org/accordion": "2.2.7",
    "@nextui-org/avatar": "2.2.6",
    "@nextui-org/button": "2.2.9",
    "@nextui-org/card": "2.2.9",
    "@nextui-org/code": "2.2.6",
    "@nextui-org/image": "2.2.5",
    "@nextui-org/input": "2.4.8",
    "@nextui-org/kbd": "2.2.6",
    "@nextui-org/link": "2.2.7",
    "@nextui-org/modal": "2.2.7",
    "@nextui-org/navbar": "2.2.8",
    "@nextui-org/progress": "2.2.6",
    "@nextui-org/radio": "2.3.8",
    "@nextui-org/react": "2.6.11",
    "@nextui-org/select": "2.4.9",
    "@nextui-org/shared-icons": "2.1.1",
    "@nextui-org/snippet": "2.2.10",
    "@nextui-org/spinner": "2.2.6",
    "@nextui-org/switch": "2.2.8",
    "@nextui-org/system": "2.4.6",
    "@nextui-org/table": "2.2.8",
    "@nextui-org/theme": "2.4.5",
    "@nextui-org/user": "2.2.6",
    "@opennextjs/cloudflare": "1.20.8",
    "@react-aria/ssr": "3.9.2",
    "@react-aria/visually-hidden": "3.8.18",
    "apexcharts": "3.49.0",
    "autoprefixer": "10.4.19",
    "canvas-confetti": "1.9.2",
    "clsx": "2.1.1",
    "color2k": "2.0.3",
    "contentlayer2": "0.5.8",
    "date-fns": "3.6.0",
    "framer-motion": "11.18.2",
    "intl-messageformat": "10.5.11",
    "next": "15.5.27",
    "next-contentlayer2": "0.5.8",
    "next-intl": "3.26.5",
    "next-themes": "0.3.0",
    "postcss": "8.4.38",
    "react": "19.2.8",
    "react-apexcharts": "1.4.1",
    "react-dom": "19.2.8",
    "rtl-detect": "1.1.2",
    "tailwind-variants": "0.2.1",
    "tailwindcss": "3.4.3",
    "zod": "3.23.4"
  },
  "devDependencies": {
