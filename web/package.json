    "@types/node": "20.12.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/rtl-detect": "1.0.3",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
